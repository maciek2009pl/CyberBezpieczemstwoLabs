@page
@model CyberBezpieczemstwoLab.Areas.Identity.Pages.Account.UserList
@{
    ViewData["Title"] = "User List";
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<button type="button" class="btn btn-success mb-3"
        data-bs-toggle="modal" data-bs-target="#userAddModal">
    Add User
</button>

@if (Model.Users.Count == 0)
{
    <p>No users found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Login</th>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Login</td>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>
                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#userEditModal"
                                data-user-id="@user.Id"
                                data-login="@user.Login"
                                data-email="@user.Email"
                                data-role="@user.Roles.FirstOrDefault()">
                            Edit
                        </button>
                        @if (User.IsInRole("Administrator"))
                        {
                            <form method="post" asp-page-handler="Remove" class="d-inline">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-danger">Remove</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="modal fade" id="userEditModal" aria-labelledby="userEditModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <div class="modal-header">
                    <h2 class="modal-title" id="userEditModalLabel">Edit user</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <input asp-for="Input.UserId" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Input.Login" class="form-label">Login</label>
                        <input asp-for="Input.Login" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Login" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <fieldset>
                        <legend class="col-form-label">Roles</legend>
                        @for (var index = 0; index < Model.AvailableRoles.Count; index++)
                        {
                            var role = Model.AvailableRoles[index];
                            var radioId = $"edit-user-role-{index}";
                            <div class="form-check">
                                <input class="form-check-input user-role-radio"
                                       type="radio"
                                       id="@radioId"
                                       name="Input.Role"
                                       value="@role"
                                       checked="@(Model.ShowEditModal && Model.Input.Role == role ? "checked" : null)" />
                                <label class="form-check-label" for="@radioId">@role</label>
                            </div>
                        }
                        <span asp-validation-for="Input.Role" class="text-danger"></span>
                    </fieldset>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="userAddModal" tabindex="-1" aria-labelledby="userAddModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Add">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="userAddModalLabel">Add user</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="NewUser.Login" class="form-label">Login</label>
                        <input asp-for="NewUser.Login" class="form-control" autocomplete="username" />
                        <span asp-validation-for="NewUser.Login" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewUser.Email" class="form-label">Email</label>
                        <input asp-for="NewUser.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="NewUser.Email" class="text-danger"></span>
                    </div>
                    <fieldset>
                        <legend class="col-form-label">Role</legend>
                        @for (var index = 0; index < Model.AvailableRoles.Count; index++)
                        {
                            var role = Model.AvailableRoles[index];
                            var radioId = $"add-user-role-{index}";
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       id="@radioId"
                                       asp-for="NewUser.Role"
                                       value="@role"
                                       checked="@(Model.ShowAddModal && Model.NewUser.Role == role ? "checked" : null)" />
                                <label class="form-check-label" for="@radioId">@role</label>
                            </div>
                        }
                        <span asp-validation-for="NewUser.Role" class="text-danger"></span>
                    </fieldset>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save User</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const editModal = document.getElementById("userEditModal");
        editModal.addEventListener("show.bs.modal", event => {
            const button = event.relatedTarget;
            if (!button) {
                return;
            }

            document.getElementById("Input_UserId").value = button.dataset.userId;
            document.getElementById("Input_Login").value = button.dataset.login ?? "";
            document.getElementById("Input_Email").value = button.dataset.email ?? "";

            const selectedRole = button.dataset.role ?? "";
            editModal.querySelectorAll(".user-role-radio").forEach(radio => {
                radio.checked = radio.value === selectedRole;
            });
        });

        @if (Model.ShowAddModal)
        {
            <text>
                new bootstrap.Modal(addModal).show();
            </text>
        }

        @if (Model.ShowEditModal)
        {
            <text>
                new bootstrap.Modal(editModal).show();
            </text>
        }
    </script>
}
