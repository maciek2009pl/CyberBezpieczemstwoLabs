@page
@model CyberBezpieczemstwoLab.Areas.Identity.Pages.Account.AdminPanel
@{
    ViewData["Title"] = "AdminPanel";
}

<h1>@ViewData["Title"]</h1>

<h2>Canary accounts</h2>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Login</th>
            <th scope="col">Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model.CanaryAccounts)
        {
            <tr>
                <td>@account.UserName</td>
                <td>@account.Email</td>
            </tr>
        }
    </tbody>
</table>
